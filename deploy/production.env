# Production env for EC2 public hosting
NODE_ENV=production
PORT=3000
# Port 80 is not open on security group sg-003e3a08a29694c44, so links must carry
# the port or nobody can open them. Drop the ":3000" once TCP 80 is allowed inbound
# and WhatsApp will linkify registration URLs again — deploy/serve-public-port.sh
# verifies the port really is reachable before you rely on it.
PUBLIC_URL=http://3.16.112.125:3000
ADMIN_REG_EMAIL=omkarsinha4@gmail.com
MAIL_FROM="ArcusVerse <acplcricket@gmail.com>"

# Required for real outbound email (without these, emails only log as dry-run):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=acplcricket@gmail.com
# CricHeroes has no public developer API. Team stats sync from server/cricheroes-seed.json
